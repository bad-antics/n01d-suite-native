<Window x:Class="N01D.Arcade.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="N01D Arcade — Settings" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#0a0a0f" Foreground="#00ff88"
        FontFamily="Consolas" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0" Text="⚙ SETTINGS" FontSize="18" FontWeight="Bold"
                   Foreground="#00ff88" Margin="0,0,0,16"/>

        <!-- ROM PATH -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="ROM LIBRARY PATH" FontSize="11" Foreground="#555577" FontWeight="Bold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRomsPath" Grid.Column="0" Background="#111118" Foreground="#cccccc"
                         BorderBrush="#1a1a2e" BorderThickness="1" Padding="8,6" FontSize="12"/>
                <Button Grid.Column="1" Content="Browse" Background="#1a1a2e" Foreground="#00ff88"
                        BorderBrush="#00ff88" BorderThickness="1" Padding="12,6" Margin="8,0,0,0"
                        Click="BtnBrowse_Click" Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <!-- EMULATOR STATUS -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="DETECTED EMULATORS" FontSize="11"
                       Foreground="#555577" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox x:Name="LstEmulators" Background="#0d0d14" BorderBrush="#1a1a2e"
                     BorderThickness="1" Foreground="#cccccc" FontSize="12">
            </ListBox>
        </DockPanel>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Rescan Games" Background="#1a1a2e" Foreground="#00ff88"
                    BorderBrush="#00ff88" BorderThickness="1" Padding="16,8" Margin="0,0,8,0"
                    Click="BtnRescan_Click" Cursor="Hand"/>
            <Button Content="Save" Background="#00ff88" Foreground="#0a0a0f"
                    BorderThickness="0" Padding="20,8" FontWeight="Bold"
                    Click="BtnSave_Click" Cursor="Hand"/>
            <Button Content="Cancel" Background="#1a1a2e" Foreground="#888899"
                    BorderBrush="#333344" BorderThickness="1" Padding="16,8" Margin="8,0,0,0"
                    Click="BtnCancel_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
