<Window x:Class="N01D.Arcade.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:N01D.Arcade"
        Title="N01D ARCADE" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0f" Foreground="#00ff88"
        FontFamily="Consolas">

    <Window.Resources>
        <!-- System Card Button Style -->
        <Style x:Key="SystemCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#111118"/>
            <Setter Property="Foreground" Value="#00ff88"/>
            <Setter Property="BorderBrush" Value="#1a1a2e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a1a2e"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00ff88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00ff88"/>
                                <Setter Property="Foreground" Value="#0a0a0f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Game List Item Style -->
        <Style x:Key="GameItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a1a2e"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0d2818"/>
                                <Setter Property="Foreground" Value="#00ff88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00ff88"/>
            <Setter Property="Foreground" Value="#0a0a0f"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33ffaa"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#009955"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="Foreground" Value="#00ff88"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#00ff88"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0d2818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#111118"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0d0d14" Padding="16,12" BorderBrush="#1a1a2e" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="▶ N01D ARCADE" FontSize="22" FontWeight="Bold" Foreground="#00ff88"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  RETRO GAME LAUNCHER" FontSize="12" Foreground="#555577"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSystemCount" Text="0 systems" Foreground="#555577" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtGameCount" Text="0 games" Foreground="#555577" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="⚙ SETTINGS" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: SYSTEM LIST -->
            <Border Grid.Column="0" Background="#0d0d14" BorderBrush="#1a1a2e" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SYSTEMS" FontSize="11" Foreground="#555577"
                               Margin="12,10,0,6" FontWeight="Bold"/>
                    <ListBox x:Name="LstSystems" Background="Transparent" BorderThickness="0"
                             SelectionChanged="LstSystems_SelectionChanged"
                             ItemContainerStyle="{StaticResource GameItemStyle}">
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- CENTER: GAME LIST -->
            <DockPanel Grid.Column="1">
                <!-- Search Bar -->
                <Border DockPanel.Dock="Top" Background="#111118" Padding="12,8" BorderBrush="#1a1a2e" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Background="#0a0a0f" Foreground="#cccccc"
                                 BorderBrush="#1a1a2e" BorderThickness="1" Padding="8,6"
                                 FontSize="13" TextChanged="TxtSearch_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="#0a0a0f"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="🔍 Search games..." Foreground="#444455" FontSize="13"
                                   IsHitTestVisible="False" Margin="12,7,0,0"
                                   Visibility="{Binding ElementName=TxtSearch, Path=Text.Length, Converter={x:Static local:ZeroToVisibleConverter.Instance}}"/>
                    </Grid>
                </Border>

                <!-- Game List -->
                <ListBox x:Name="LstGames" Background="Transparent" BorderThickness="0"
                         SelectionChanged="LstGames_SelectionChanged"
                         MouseDoubleClick="LstGames_MouseDoubleClick"
                         ItemContainerStyle="{StaticResource GameItemStyle}">
                </ListBox>
            </DockPanel>

            <!-- RIGHT: GAME INFO PANEL -->
            <Border Grid.Column="2" Background="#0d0d14" BorderBrush="#1a1a2e" BorderThickness="1,0,0,0">
                <DockPanel Margin="16">
                    <!-- Launch Button at Bottom -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="BtnLaunch" Content="▶  LAUNCH GAME" 
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnLaunch_Click" IsEnabled="False"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="📂 Open Folder"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnOpenFolder_Click" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="🔧 Emulator"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnOpenEmulator_Click" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Game Info -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtGameTitle" Text="SELECT A GAME" FontSize="16"
                                       FontWeight="Bold" Foreground="#00ff88" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtGameSystem" Text="" FontSize="12"
                                       Foreground="#888899" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtGameFile" Text="" FontSize="11"
                                       Foreground="#555566" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtGameSize" Text="" FontSize="11"
                                       Foreground="#555566" Margin="0,0,0,12"/>

                            <Border Background="#111118" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="EMULATOR" FontSize="10" Foreground="#555577" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtEmulatorName" Text="-" FontSize="12"
                                               Foreground="#cccccc" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#111118" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="FILE FORMATS" FontSize="10" Foreground="#555577" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtFileFormats" Text="-" FontSize="11"
                                               Foreground="#888899" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#111118" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ROM PATH" FontSize="10" Foreground="#555577" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtRomPath" Text="-" FontSize="10"
                                               Foreground="#555566" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0d0d14" Padding="12,6" BorderBrush="#1a1a2e" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#555577" FontSize="11"/>
                <TextBlock x:Name="TxtVersion" Text="N01D Arcade v1.0.0" Foreground="#333344"
                           FontSize="10" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
