<Window x:Class="N01D.Scan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="N01D.Scan" Height="740" Width="1040"
        Background="{StaticResource N01DBackgroundBrush}"
        Foreground="{StaticResource N01DTextBrush}"
        FontFamily="{StaticResource N01DMonoFont}"
        Style="{StaticResource N01DWindow}">
    <DockPanel>
        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Background="{StaticResource N01DBackgroundAltBrush}" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Target:" VerticalAlignment="Center" Margin="8,6"/>
            <TextBox   Grid.Column="1" x:Name="txtTarget" Text="192.168.1.1" Margin="2,4"
                       Padding="4,2"
                       Background="{StaticResource N01DBackgroundBrush}"
                       Foreground="{StaticResource N01DPrimaryBrush}"
                       BorderBrush="{StaticResource N01DBorderBrush}"
                       ToolTip="IP, CIDR (192.168.1.0/24), or hostname"/>
            <TextBlock Grid.Column="2" Text="Ports:" VerticalAlignment="Center" Margin="8,6"/>
            <TextBox   Grid.Column="3" x:Name="txtPorts" Text="22,80,443,8080,3389" Margin="2,4"
                       Padding="4,2"
                       Background="{StaticResource N01DBackgroundBrush}"
                       Foreground="{StaticResource N01DPrimaryBrush}"
                       BorderBrush="{StaticResource N01DBorderBrush}"
                       ToolTip="Comma-separated ports or range (1-1024)"/>
            <TextBlock Grid.Column="4" Text="Timeout:" VerticalAlignment="Center" Margin="8,6"/>
            <TextBox   Grid.Column="5" x:Name="txtTimeout" Text="500" Margin="2,4"
                       Padding="4,2"
                       Background="{StaticResource N01DBackgroundBrush}"
                       Foreground="{StaticResource N01DPrimaryBrush}"
                       BorderBrush="{StaticResource N01DBorderBrush}"/>
            <Button Grid.Column="7" x:Name="btnScan" Content="[ SCAN ]"
                    Margin="6,4" Padding="10,3" Click="BtnScan_Click"/>
            <Button Grid.Column="8" x:Name="btnStop" Content="[ STOP ]"
                    Margin="2,4,8,4" Padding="10,3" Click="BtnStop_Click" IsEnabled="False"/>
        </Grid>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource N01DBackgroundAltBrush}">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"
                           Foreground="{StaticResource N01DPrimaryBrush}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblProgress" Text="0 / 0"
                           Foreground="{StaticResource N01DTextDimBrush}" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblOpen" Text="Open: 0"
                           Foreground="{StaticResource N01DSecondaryBrush}" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Progress bar -->
        <ProgressBar x:Name="progBar" DockPanel.Dock="Bottom" Height="3"
                     Background="{StaticResource N01DBackgroundAltBrush}"
                     Foreground="{StaticResource N01DPrimaryBrush}"
                     BorderThickness="0"/>

        <!-- Main: results + detail -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="lstResults" Grid.Column="0" Margin="4"
                      Background="{StaticResource N01DBackgroundBrush}"
                      Foreground="{StaticResource N01DTextBrush}"
                      BorderBrush="{StaticResource N01DBorderBrush}"
                      SelectionChanged="LstResults_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Host"    Width="155" DisplayMemberBinding="{Binding Host}"/>
                        <GridViewColumn Header="Port"    Width="65"  DisplayMemberBinding="{Binding Port}"/>
                        <GridViewColumn Header="State"   Width="75"  DisplayMemberBinding="{Binding State}"/>
                        <GridViewColumn Header="Service" Width="100" DisplayMemberBinding="{Binding Service}"/>
                        <GridViewColumn Header="Banner"  Width="240" DisplayMemberBinding="{Binding Banner}"/>
                        <GridViewColumn Header="RTT ms"  Width="65"  DisplayMemberBinding="{Binding RttMs}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Detail sidebar -->
            <Border Grid.Column="1" Margin="0,4,4,4"
                    Background="{StaticResource N01DBackgroundAltBrush}"
                    BorderBrush="{StaticResource N01DBorderBrush}" BorderThickness="1">
                <StackPanel Margin="8">
                    <TextBlock Text="DETAIL" FontSize="11"
                               Foreground="{StaticResource N01DTextDimBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="lblDetailHost"    Text="Host: —"    FontSize="13" Margin="0,2"
                               Foreground="{StaticResource N01DPrimaryBrush}"/>
                    <TextBlock x:Name="lblDetailPort"    Text="Port: —"    FontSize="13" Margin="0,2"/>
                    <TextBlock x:Name="lblDetailState"   Text="State: —"   FontSize="13" Margin="0,2"/>
                    <TextBlock x:Name="lblDetailService" Text="Service: —" FontSize="13" Margin="0,2"
                               Foreground="{StaticResource N01DSecondaryBrush}"/>
                    <TextBlock x:Name="lblDetailRtt"     Text="RTT: — ms"  FontSize="13" Margin="0,2"/>
                    <Separator Margin="0,8" Background="{StaticResource N01DBorderBrush}"/>
                    <TextBlock Text="Banner:" FontSize="11"
                               Foreground="{StaticResource N01DTextDimBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtBanner" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource N01DTextBrush}" FontSize="12"/>
                    <Separator Margin="0,8" Background="{StaticResource N01DBorderBrush}"/>
                    <TextBlock Text="Scan log:" FontSize="11"
                               Foreground="{StaticResource N01DTextDimBrush}" Margin="0,0,0,4"/>
                    <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtLog" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource N01DTextDimBrush}"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
